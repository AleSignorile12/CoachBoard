    "Add kids in the Kids tab and their documents show up here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Kinder im Tab „Kinder“ hinzu, dann erscheinen ihre Dokumente hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade niños en la pestaña Niños y sus documentos aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des enfants dans l'onglet Enfants et leurs documents apparaîtront ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj djecu u kartici Djeca i njihovi će se dokumenti pojaviti ovdje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i bambini nella scheda Bambini e i loro documenti appariranno qui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona crianças no separador Crianças e os documentos aparecem aqui."
          }
        }
      }
    },
    "Add kids in the Kids tab first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst Kinder im Tab „Kinder“ hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade niños en la pestaña Niños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord des enfants dans l'onglet Enfants."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije dodaj djecu u kartici Djeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima aggiungi i bambini nella scheda Bambini."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro adiciona crianças no separador Crianças."
          }
        }

    "The registration is paid once per season. A season runs twelve months from the month it starts in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung wird einmal pro Saison bezahlt. Eine Saison dauert zwölf Monate ab ihrem Startmonat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inscripción se paga una vez por temporada. Una temporada dura doce meses desde el mes en que empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inscription se paie une fois par saison. Une saison dure douze mois à partir de son mois de début."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upisnina se plaća jednom po sezoni. Sezona traje dvanaest mjeseci od mjeseca kad počinje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'iscrizione si paga una volta a stagione. Una stagione dura dodici mesi dal mese in cui inizia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A inscrição paga-se uma vez por época. Uma época dura doze meses a partir do mês em que começa."
          }
        }
      }
    },
    "These download the first time you translate with them (about 30 MB each)." : {
      "localizations" : {

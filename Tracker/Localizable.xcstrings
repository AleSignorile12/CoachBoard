    "The ID Copy is shared with the Certifications tab. Swipe a file to rename or delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausweiskopie wird mit dem Tab „Nachweise“ geteilt. Wische über eine Datei, um sie umzubenennen oder zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia del documento se comparte con la pestaña Certificados. Desliza un archivo para renombrarlo o eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie de la pièce d'identité est partagée avec l'onglet Certificats. Balayez un fichier pour le renommer ou le supprimer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopija osobne dijeli se s karticom Potvrde. Povuci datoteku da je preimenuješ ili izbrišeš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia del documento è condivisa con la scheda Certificati. Scorri un file per rinominarlo o eliminarlo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

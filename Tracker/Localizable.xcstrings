    "A reminder a week before, two days before and on the day, plus a little party when you open the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung eine Woche vorher, zwei Tage vorher und am Tag selbst, dazu eine kleine Party, wenn du die App öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso una semana antes, dos días antes y el mismo día, y una pequeña fiesta al abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel une semaine avant, deux jours avant et le jour même, plus une petite fête à l'ouverture de l'app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnik tjedan dana prije, dva dana prije i na sam dan, uz malu proslavu kad otvoriš aplikaciju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria una settimana prima, due giorni prima e il giorno stesso, più una piccola festa quando apri l'app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete uma semana antes, dois dias antes e no próprio dia, e uma pequena festa quando abres a app."
          }
        }
      }
    },

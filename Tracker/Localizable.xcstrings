    },
    "These work with no internet. To remove one, go to System Settings › General › Language & Region › Translation Languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie funktionieren ohne Internet. Zum Entfernen: Systemeinstellungen › Allgemein › Sprache & Region › Übersetzungssprachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionan sin internet. Para eliminar uno, ve a Ajustes del Sistema › General › Idioma y región › Idiomas de traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles fonctionnent sans internet. Pour en supprimer une, allez dans Réglages Système › Général › Langue et région › Langues de traduction."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rade bez interneta. Za uklanjanje idite u Postavke sustava › Općenito › Jezik i regija › Jezici prijevoda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funzionano senza internet. Per rimuoverne una, vai in Impostazioni di Sistema › Generali › Lingua e Zona › Lingue di traduzione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionam sem internet. Para remover um, vá a Definições do Sistema › Geral › Idioma e região › Idiomas de tradução."
          }
        }
      }
    },
    "This also deletes their files and payment history." : {

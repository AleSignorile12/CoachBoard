    "Add the first kid. Payments, documents and birthdays follow from there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das erste Kind hinzu. Zahlungen, Dokumente und Geburtstage folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el primer niño. Pagos, documentos y cumpleaños vienen después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le premier enfant. Paiements, documents et anniversaires suivront."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj prvo dijete. Plaćanja, dokumenti i rođendani slijede."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il primo bambino. Pagamenti, documenti e compleanni arrivano dopo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a primeira criança. Pagamentos, documentos e aniversários vêm a seguir."
          }
        }
      }
    },

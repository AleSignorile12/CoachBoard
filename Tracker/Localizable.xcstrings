    "Pick at least one day. Only training days can be marked in the calendar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens einen Tag. Im Kalender lassen sich nur Trainingstage markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos un día. En el calendario solo se pueden marcar los días de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins un jour. Seuls les jours d'entraînement peuvent être marqués dans le calendrier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi barem jedan dan. U kalendaru se mogu označiti samo dani treninga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno un giorno. Nel calendario si possono segnare solo i giorni di allenamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe pelo menos um dia. No calendário só se podem marcar os dias de treino."
          }
        }
      }
    },
    "Pick yours and the one the kids speak. The translator knows 59 and works offline once a language is downloaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deine und die der Kinder. Der Übersetzer kennt 59 und funktioniert offline, sobald eine Sprache geladen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el tuyo y el de los niños. El traductor conoce 59 y funciona sin conexión una vez descargado el idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la vôtre et celle des enfants. Le traducteur en connaît 59 et fonctionne hors ligne une fois la langue téléchargée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi svoj jezik i jezik djece. Prevoditelj zna 59 jezika i radi bez interneta kad preuzmeš jezik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la tua e quella dei bambini. Il traduttore ne conosce 59 e funziona offline dopo aver scaricato una lingua."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe a tua e a das crianças. O tradutor conhece 59 e funciona offline depois de descarregares a língua."
          }
        }
      }
    },

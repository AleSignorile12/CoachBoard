    "Tracker asks for Face ID or your passcode every time you open it, and stays hidden in the app switcher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracker fragt bei jedem Öffnen nach Face ID oder deinem Code und bleibt im App-Umschalter verborgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracker pide Face ID o tu código cada vez que lo abres y se oculta en el selector de apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracker demande Face ID ou votre code à chaque ouverture et reste masqué dans le sélecteur d'apps."

    "Only the symbol changes, the amounts stay as they are. New amounts count from this month on; earlier months keep the ones they had." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Symbol ändert sich, die Beträge bleiben. Neue Beträge gelten ab diesem Monat; frühere Monate behalten ihre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el símbolo, los importes no cambian. Los nuevos importes cuentan desde este mes; los meses anteriores conservan los suyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le symbole change, les montants restent les mêmes. Les nouveaux montants comptent à partir de ce mois ; les mois précédents gardent les leurs."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijenja se samo simbol, iznosi ostaju isti. Novi iznosi vrijede od ovog mjeseca; raniji mjeseci zadržavaju svoje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo il simbolo, gli importi restano uguali. I nuovi importi valgono da questo mese; i mesi precedenti tengono i loro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o símbolo muda, os valores mantêm-se. Os novos valores contam a partir deste mês; os meses anteriores mantêm os seus."
          }
        }
      }
    },
    "Only these days can be marked in the practice calendar. You can change them there anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur diese Tage lassen sich im Trainingskalender markieren. Du kannst sie dort jederzeit ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo estos días se pueden marcar en el calendario de entrenamientos. Puedes cambiarlos allí cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls ces jours peuvent être marqués dans le calendrier d'entraînement. Vous pouvez les modifier à tout moment."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo se ti dani mogu označiti u kalendaru treninga. Možeš ih ondje promijeniti bilo kada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo questi giorni si possono segnare nel calendario allenamenti. Puoi cambiarli lì quando vuoi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só estes dias podem ser marcados no calendário de treinos. Podes alterá-los lá quando quiseres."
          }
        }
      }
    },

    "Double-click a row or use the circle to mark it paid. Right-click for more. Set the amounts in My Profile › Fees." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke auf eine Zeile oder nutze den Kreis, um sie als bezahlt zu markieren. Rechtsklick für mehr. Beträge unter Mein Profil › Beiträge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz doble clic en una fila o usa el círculo para marcarla como pagada. Clic derecho para más. Ajusta los importes en Mi perfil › Cuotas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur une ligne ou utilisez le cercle pour la marquer payée. Clic droit pour plus. Réglez les montants dans Mon profil › Cotisations."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvaput kliknite redak ili krug da ga označite plaćenim. Desni klik za više. Iznose postavite u Moj profil › Članarine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su una riga o usa il cerchio per segnarla come pagata. Clic destro per altre opzioni. Imposta gli importi in Il mio profilo › Quote."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça duplo clique numa linha ou use o círculo para a marcar como paga. Clique direito para mais. Defina os valores em O meu perfil › Quotas."
          }
        }
      }
    },

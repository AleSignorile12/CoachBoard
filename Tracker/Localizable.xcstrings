        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aura %2$lld ans le %3$@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ slavi %2$lld. rođendan %3$@."
          }

    "Kids, payments, files and the practice log are saved in your iCloud and stay in sync on your devices, even if you delete the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinder, Zahlungen, Dateien und das Trainingsprotokoll werden in deiner iCloud gespeichert und bleiben auf deinen Geräten synchron, auch wenn du die App löschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los niños, los pagos, los archivos y el registro de entrenamientos se guardan en tu iCloud y se sincronizan en tus dispositivos, aunque elimines la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enfants, les paiements, les fichiers et le journal d'entraînement sont enregistrés dans votre iCloud et restent synchronisés sur vos appareils, même si vous supprimez l'app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Djeca, plaćanja, datoteke i dnevnik treninga spremaju se u tvoj iCloud i ostaju usklađeni na tvojim uređajima, čak i ako izbrišeš aplikaciju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambini, pagamenti, file e registro allenamenti sono salvati nel tuo iCloud e restano sincronizzati sui tuoi dispositivi, anche se elimini l'app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As crianças, os pagamentos, os ficheiros e o registo de treinos ficam guardados no teu iCloud e sincronizados nos teus dispositivos, mesmo que apagues a app."
          }
        }
      }
    },

        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracker traži Face ID ili šifru svaki put kad ga otvoriš i ostaje skriven u prebacivaču aplikacija."
          }
        },
        "it": {
          "stringUnit": {

        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles se téléchargent la première fois que vous traduisez avec (environ 30 Mo chacune)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimaju se pri prvom prevođenju (oko 30 MB svaki)."

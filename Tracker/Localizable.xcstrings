    "The Mac's own translator doesn't have these, so they're translated online by MyMemory, a free service with no account. It needs the internet and allows about 5,000 characters a day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Übersetzer des Mac hat diese Sprachen nicht, daher übersetzt sie MyMemory online, ein kostenloser Dienst ohne Konto. Er braucht Internet und erlaubt etwa 5.000 Zeichen pro Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El traductor del Mac no tiene estos idiomas, así que los traduce en línea MyMemory, un servicio gratuito sin cuenta. Necesita internet y permite unos 5.000 caracteres al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le traducteur du Mac n'a pas ces langues : elles sont traduites en ligne par MyMemory, un service gratuit sans compte. Il faut internet, et environ 5 000 caractères par jour sont permis."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macov prevoditelj nema ove jezike pa ih online prevodi MyMemory, besplatna usluga bez računa. Potreban je internet i dopušta oko 5.000 znakova dnevno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traduttore del Mac non ha queste lingue, quindi vengono tradotte online da MyMemory, un servizio gratuito senza account. Serve internet e permette circa 5.000 caratteri al giorno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tradutor do Mac não tem estes idiomas, por isso são traduzidos online pelo MyMemory, um serviço gratuito sem conta. Precisa de internet e permite cerca de 5000 caracteres por dia."
          }
        }
      }
    },
    "The microphone couldn't start. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

    "CoachBoard asks for Face ID or your passcode every time you open it, and stays hidden in the app switcher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachBoard fragt bei jedem Öffnen nach Face ID oder deinem Code und bleibt im App-Umschalter verborgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachBoard pide Face ID o tu código cada vez que lo abres y se oculta en el selector de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachBoard demande Face ID ou votre code à chaque ouverture et reste masqué dans le sélecteur d'apps."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachBoard traži Face ID ili šifru svaki put kad ga otvoriš i ostaje skriven u prebacivaču aplikacija."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachBoard chiede Face ID o il codice ogni volta che lo apri e resta nascosto nel selettore delle app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

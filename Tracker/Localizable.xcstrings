    "macOS downloads these once and shares them with its other apps. Then they work with no internet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lädt sie einmal und teilt sie mit seinen anderen Apps. Danach funktionieren sie ohne Internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS los descarga una vez y los comparte con sus otras apps. Después funcionan sin internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS les télécharge une fois et les partage avec ses autres apps. Elles fonctionnent ensuite sans internet."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ih preuzme jednom i dijeli s ostalim aplikacijama. Zatim rade bez interneta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS le scarica una volta e le condivide con le altre app. Poi funzionano senza internet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS descarrega-os uma vez e partilha-os com as outras apps. Depois funcionam sem internet."
          }
        }
      }
    },

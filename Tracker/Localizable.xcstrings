    "No registration: the Registration column and buttons are hidden. A season runs twelve months from the month it starts in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Anmeldegebühr: Spalte und Tasten dafür sind ausgeblendet. Eine Saison dauert zwölf Monate ab ihrem Startmonat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin inscripción: la columna y los botones de inscripción se ocultan. Una temporada dura doce meses desde el mes en que empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'inscription : la colonne et les boutons d'inscription sont masqués. Une saison dure douze mois à partir de son mois de début."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez upisnine: stupac i gumbi za upisninu su skriveni. Sezona traje dvanaest mjeseci od mjeseca kad počinje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna iscrizione: la colonna e i pulsanti dell'iscrizione sono nascosti. Una stagione dura dodici mesi dal mese in cui inizia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem inscrição: a coluna e os botões de inscrição ficam ocultos. Uma época dura doze meses a partir do mês em que começa."
          }
        }
      }
    },

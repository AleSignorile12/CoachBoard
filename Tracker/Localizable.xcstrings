    "Each language is about 30 MB. Download on Wi-Fi before training, then translate anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Sprache hat etwa 30 MB. Lade sie vor dem Training im WLAN, dann übersetzt du überall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada idioma ocupa unos 30 MB. Descárgalo con Wi-Fi antes del entrenamiento y traduce donde quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque langue fait environ 30 Mo. Téléchargez-la en Wi-Fi avant l'entraînement, puis traduisez partout."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki jezik ima oko 30 MB. Preuzmi ga na Wi-Fiju prije treninga, a zatim prevodi bilo gdje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lingua pesa circa 30 MB. Scaricala col Wi-Fi prima dell'allenamento, poi traduci ovunque."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada língua tem cerca de 30 MB. Descarrega-a por Wi-Fi antes do treino e traduz em qualquer lado."
          }
        }
      }
    },

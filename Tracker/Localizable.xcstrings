    "Only these days can be marked in the practice calendar. You can change them there anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Tage lassen sich im Trainingskalender markieren. Du kannst sie dort jederzeit ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo estos días se pueden marcar en el calendario de entrenamientos. Puedes cambiarlos allí cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls ces jours peuvent être marqués dans le calendrier d'entraînement. Vous pouvez les modifier à tout moment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo se ti dani mogu označiti u kalendaru treninga. Možeš ih ondje promijeniti bilo kada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo questi giorni si possono segnare nel calendario allenamenti. Puoi cambiarli lì quando vuoi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só estes dias podem ser marcados no calendário de treinos. Podes alterá-los lá quando quiseres."
          }
        }
      }
    },

            "state": "new",
            "value": "CoachBoard"
          }
        }
      },
      "shouldTranslate": false
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Tracker"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard nutzt die Kamera, um Dokumente wie Ausweiskopien und ärztliche Atteste zu fotografieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard uses the camera to take pictures of documents like ID copies and medical certificates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard usa la cámara para fotografiar documentos como copias de documentos de identidad y certificados médicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard utilise l'appareil photo pour photographier des documents comme des copies de pièces d'identité et des certificats médicaux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard koristi kameru za fotografiranje dokumenata poput kopija osobnih iskaznica i liječničkih potvrda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard usa la fotocamera per fotografare documenti come copie dei documenti d'identità e certificati medici."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CoachBoard usa a câmara para fotografar documentos como cópias de documentos de identificação e atestados médicos."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard nutzt Face ID, damit die Daten deines Teams privat bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard uses Face ID to keep your team's data private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard usa Face ID para mantener privados los datos de tu equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard utilise Face ID pour garder privées les données de votre équipe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard koristi Face ID da podaci tvoje ekipe ostanu privatni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard usa Face ID per mantenere privati i dati della tua squadra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CoachBoard usa o Face ID para manter privados os dados da tua equipa."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard nutzt das Mikrofon, damit du in den Übersetzer sprechen kannst, statt zu tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard uses the microphone so you can speak into the translator instead of typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard usa el micrófono para que hables al traductor en lugar de escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard utilise le micro pour que vous puissiez parler au traducteur au lieu d’écrire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard koristi mikrofon kako biste mogli govoriti u prevoditelj umjesto tipkanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard usa il microfono per parlare nel traduttore invece di scrivere."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CoachBoard usa o microfone para que possa falar para o tradutor em vez de escrever."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard wandelt das Gesprochene in Text für den Übersetzer um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard turns what you say into text for the translator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard convierte lo que dices en texto para el traductor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard transforme ce que vous dites en texte pour le traducteur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard pretvara ono što kažete u tekst za prevoditelj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachBoard trasforma ciò che dici in testo per il traduttore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CoachBoard transforma o que diz em texto para o tradutor."
          }
        }
      }
    }
  },
  "version": "1.0"
}
